// JoinQueue Configuration
//
// master_switch                  - set false to disable the mod entirely
// queue_activation_threshold     - min online players before queue activates (0 = always)
// max_queue_size                 - max players allowed in queue (0 = unlimited)
// min_queue_seconds              - minimum wait time per player (0 = disabled)
// ticks_between_joins            - release interval for normal players (20t = 1s)
// ticks_between_joins_vip        - release interval for VIP players
// restart_queue_duration_seconds - seconds queue is forced on after server start
// queue_message                  - message shown on the queue screen
// queue_paused_message           - message shown when queue is paused
// chunk_preload_radius           - chunks preloaded around spawn (0-8, vanilla only)
// hold_back_ms                   - max ms to wait for chunks before releasing anyway
// staff                          - players who skip the queue and bypass slot limits
// fast_queue                     - players placed at front of queue with faster timer
//
// Commands: /joinqueue toggle | pause | resume | reload | status
//           /joinqueue staff add|remove <player>
//           /joinqueue vip   add|remove <player>
//           /joinqueue list  staff|vip
//
{
  "master_switch": true,
  "ticks_between_joins": 300,
  "ticks_between_joins_vip": 100,
  "restart_queue_duration_seconds": 60,
  "queue_activation_threshold": 0,
  "max_queue_size": 0,
  "chunk_preload_radius": 3,
  "hold_back_ms": 1500,
  "min_queue_seconds": 0,
  "queue_message": "Please wait, you are in the queue.",
  "queue_paused_message": "The queue is currently paused. Please wait.",
  "staff": [
    "BrotalityREAL"
  ],
  "fast_queue": []
}
